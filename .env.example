# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Mock data mode ---
# Anything other than the literal string "false" keeps the app on local mock data.
# See README.md -> "Mock Data Mode" and docs/BACKEND_API_SPEC.md.
NEXT_PUBLIC_USE_MOCK_DATA=true

# --- Real backend (Next.js Route Handlers, same origin) ---
# Leave BASE_URL empty in production: Route Handlers live in this same app.
NEXT_PUBLIC_BASE_URL=
# Must be /api/v1 once mock mode is off (NOT /v1) — middleware.ts excludes /api/*
# from the auth-redirect gate; leaving this as /v1 would send real API calls
# through the page-auth middleware and get them redirected to /login as HTML.
NEXT_PUBLIC_API_V1_ROOT=/api/v1

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_, never expose to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Only used if forwarding /api/aid-help-request to an external backend. Leave unset.
AID_HELP_REQUEST_BACKEND_URL=
